<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_blue"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/checkinAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="● 1 HOUR LATER"
            android:textColor="#4A7A8A"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/checkinIntentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="You set out to check your messages.\n\nDid you do it?"
            android:textColor="#1A2D35"
            android:textSize="28sp"
            android:lineSpacingMultiplier="1.2"
            android:fontFamily="serif"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="32dp"
            android:background="#AACCDD"/>

        <Button
            android:id="@+id/btnYes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yes — done"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A2D35"
            android:padding="18dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnPartly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Partly — I drifted a little"
            android:textColor="#1A2D35"
            android:backgroundTint="#C4E8F0"
            android:padding="18dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No, I got pulled away"
            android:textColor="#1A2D35"
            android:backgroundTint="#C4E8F0"
            android:padding="18dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="32dp"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Honest answers train better intents."
            android:textColor="#4A7A8A"
            android:textSize="13sp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>